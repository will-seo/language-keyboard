    {
      "question": "How do I type accented vowels like ά or ή?",
      "answer": "The key to the right of L is the tonos dead key. Press it, then the vowel, to get an accented character such as ά, έ, ή, ί, ό, ύ, or ώ.",
      "schema": true
    },
    {
      "question": "Where is the final sigma (ς)?",
      "answer": "The final sigma sits on the W key, since Greek has no direct equivalent for that position.",
      "schema": true
    }
